# --- Telegram-аккаунт-проверяльщик (my.telegram.org → API development tools) ---
API_ID=
API_HASH=
# Строковая сессия после python login.py (для хостинга на GitHub Actions)
SESSION=

# --- Локальный сервис (спека §3) ---
# Порт, по умолчанию 8000
PORT=8000
# ОБЯЗАТЕЛЬНО: без пароля сервис не запустится на 0.0.0.0
ACCESS_PASSWORD=
# Пауза между проверками, сек (спека §6)
CHECK_DELAY=1.5

# --- Бот (режим GitHub Actions) ---
BOT_TOKEN=
APP_URL=
